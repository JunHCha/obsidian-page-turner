{
  "name": "obsidian-page-turner",
  "version": "1.0.0",
  "description": "Turn PDF pages with taps, pedals, and page-fit scrolling, like a sheet music viewer.",
  "type": "module",
  "main": "main.js",
  "scripts": {
    "build": "tsc --noEmit --skipLibCheck && node esbuild.config.mjs production",
    "dev": "node esbuild.config.mjs watch",
    "lint": "eslint .",
    "test": "vitest run",
    "version": "node version-bump.mjs"
  },
  "keywords": [
    "obsidian",
    "pdf",
    "sheet-music"
  ],
  "author": "JunHCha",
  "license": "MIT",
  "devDependencies": {
    "@eslint/js": "^9.38.0",
    "@eslint/json": "0.14.0",
    "@types/node": "^22.18.0",
    "esbuild": "^0.25.10",
    "eslint": "^9.38.0",
    "eslint-plugin-obsidianmd": "^0.4.2",
    "obsidian": "1.8.7",
    "tslib": "^2.8.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.1",
    "vite": "^6.4.4",
    "vitest": "^4.1.11"
  },
  "engines": {
    "node": ">=20"
  }
}
